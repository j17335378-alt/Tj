:root {
  --bg: #09090f;
  --surface: #151520;
  --raised: #20202d;
  --fg: #f6f3fc;
  --muted: #a6a2b2;
  --primary: #b18cff;
  --secondary: #67d9d0;
  --line: #302d3b;
  --danger: #ff8a80;
  --canvas: #000;
  --font: "IBM Plex Sans Arabic", "Segoe UI", sans-serif;
  --safe-bottom: env(safe-area-inset-bottom, 0px);
}

* { box-sizing: border-box; }
html, body { height: 100%; margin: 0; }
body {
  background: var(--bg);
  color: var(--fg);
  font-family: var(--font);
  -webkit-font-smoothing: antialiased;
}

button, input, textarea { font: inherit; color: inherit; }
button { cursor: pointer; border: 0; background: none; }
button:disabled { opacity: .5; cursor: not-allowed; }
a { color: var(--secondary); }

.app {
  max-width: 28rem;
  margin: 0 auto;
  min-height: 100dvh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
}

.offline {
  background: var(--raised);
  color: var(--muted);
  font-size: .75rem;
  line-height: 1.5;
  padding: .55rem 1rem;
}
.hidden { display: none !important; }

.view {
  flex: 1;
  min-height: 0;
  overflow: auto;
  padding: 1rem 1rem 5.5rem;
}

.nav {
  position: fixed;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 100%;
  max-width: 28rem;
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: .15rem;
  padding: .35rem .35rem calc(.35rem + var(--safe-bottom));
  background: color-mix(in oklab, var(--surface) 92%, transparent);
  border-top: 1px solid var(--line);
  backdrop-filter: blur(12px);
  z-index: 20;
}
.nav-btn {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: .15rem;
  padding: .45rem .2rem;
  border-radius: 1rem;
  color: var(--muted);
  font-size: .7rem;
  font-weight: 500;
}
.nav-btn.active {
  color: var(--primary);
  font-weight: 700;
  background: color-mix(in oklab, var(--primary) 14%, transparent);
}
.nav-ico { font-size: 1.1rem; line-height: 1; }
.badge {
  position: absolute;
  top: .15rem;
  left: 18%;
  min-width: 1.1rem;
  height: 1.1rem;
  padding: 0 .25rem;
  border-radius: 999px;
  background: var(--secondary);
  color: var(--bg);
  font-size: .65rem;
  font-weight: 800;
  display: grid;
  place-items: center;
}

.mark {
  width: 2.25rem;
  height: 2.25rem;
  border-radius: .75rem;
  background: var(--primary);
  display: grid;
  place-items: center;
  flex-shrink: 0;
}
.mark svg { width: 1.1rem; height: 1.1rem; fill: var(--bg); }
.mark.lg { width: 4rem; height: 4rem; border-radius: 1.1rem; }
.mark.lg svg { width: 1.8rem; height: 1.8rem; }

.h1 { font-size: 1.5rem; font-weight: 800; margin: 0; letter-spacing: -.02em; }
.h2 { font-size: 1.15rem; font-weight: 800; margin: 0; }
.muted { color: var(--muted); font-size: .875rem; line-height: 1.7; }
.row { display: flex; align-items: center; gap: .65rem; }
.between { display: flex; align-items: center; justify-content: space-between; gap: .75rem; }
.stack { display: flex; flex-direction: column; gap: .75rem; }
.gap-sm { gap: .45rem; }
.mt { margin-top: 1rem; }
.mt-sm { margin-top: .55rem; }
.mb { margin-bottom: 1rem; }

.card {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 1.15rem;
  padding: 1rem;
}
.card.soft { background: var(--raised); border-color: transparent; }

.field {
  display: flex;
  align-items: center;
  gap: .35rem;
  height: 3rem;
  padding: 0 .75rem;
  border-radius: 1rem;
  background: var(--raised);
  border: 1px solid var(--line);
}
.field input {
  flex: 1;
  min-width: 0;
  height: 100%;
  border: 0;
  background: transparent;
  outline: none;
  font-size: .9rem;
}
.field input::placeholder { color: var(--muted); }

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: .45rem;
  min-height: 2.75rem;
  padding: 0 1rem;
  border-radius: 1rem;
  font-weight: 700;
  font-size: .875rem;
  transition: opacity .15s ease, transform .12s ease;
}
.btn:active:not(:disabled) { transform: scale(.98); }
.btn-primary { background: var(--primary); color: var(--bg); width: 100%; }
.btn-tonal { background: color-mix(in oklab, var(--primary) 16%, transparent); color: var(--primary); width: 100%; }
.btn-ghost { background: var(--raised); color: var(--fg); border: 1px solid var(--line); width: 100%; }
.btn-danger { color: var(--danger); }
.btn-sm { min-height: 2.25rem; border-radius: .85rem; font-size: .8rem; width: auto; padding: 0 .85rem; }
.chip {
  display: inline-flex;
  align-items: center;
  border-radius: 999px;
  background: var(--raised);
  color: var(--fg);
  font-size: .75rem;
  padding: .45rem .8rem;
  border: 1px solid var(--line);
}

.pill {
  display: inline-block;
  font-size: .7rem;
  font-weight: 700;
  color: var(--secondary);
  background: color-mix(in oklab, var(--secondary) 14%, transparent);
  border-radius: 999px;
  padding: .2rem .55rem;
}

.empty {
  text-align: center;
  padding: 2.5rem 1rem;
}
.empty .mark { margin: 0 auto 1rem; }

.video-list { display: flex; flex-direction: column; gap: .55rem; }
.video-row {
  display: flex;
  gap: .7rem;
  align-items: center;
  padding: .55rem;
  border-radius: 1rem;
  background: var(--surface);
  border: 1px solid var(--line);
  text-align: start;
  width: 100%;
}
.thumb {
  width: 4.25rem;
  height: 4.25rem;
  border-radius: .85rem;
  object-fit: cover;
  background: var(--canvas);
  flex-shrink: 0;
}
.thumb.ph {
  display: grid;
  place-items: center;
  color: var(--primary);
  font-size: 1.2rem;
}
.video-row .title {
  font-size: .9rem;
  font-weight: 700;
  line-height: 1.35;
  margin: 0;
}
.video-row .meta { font-size: .72rem; color: var(--muted); margin-top: .2rem; }

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: .55rem;
}
.grid-card {
  border-radius: 1rem;
  overflow: hidden;
  border: 1px solid var(--line);
  background: var(--surface);
  text-align: start;
}
.grid-card .thumb {
  width: 100%;
  height: auto;
  aspect-ratio: 3/4;
  border-radius: 0;
}
.grid-card .pad { padding: .55rem .65rem .7rem; font-size: .78rem; font-weight: 700; }

.reels {
  height: calc(100dvh - 7.5rem);
  overflow-y: auto;
  scroll-snap-type: y mandatory;
  border-radius: 1.25rem;
  background: var(--canvas);
  border: 1px solid var(--line);
}
.reel {
  position: relative;
  height: 100%;
  scroll-snap-align: start;
  background: var(--canvas);
}
.reel img, .reel video, .reel iframe {
  width: 100%;
  height: 100%;
  object-fit: contain;
  border: 0;
  background: var(--canvas);
}
.reel .shade {
  position: absolute;
  inset-inline: 0;
  bottom: 0;
  padding: 3.5rem 1rem 1rem;
  background: linear-gradient(transparent, rgba(0,0,0,.85));
  pointer-events: none;
}
.reel .actions {
  position: absolute;
  bottom: 5rem;
  left: .75rem;
  display: flex;
  flex-direction: column;
  gap: .45rem;
  pointer-events: auto;
}
.icon-btn {
  width: 2.75rem;
  height: 2.75rem;
  border-radius: 999px;
  display: grid;
  place-items: center;
  background: rgba(0,0,0,.45);
  color: var(--fg);
  font-size: 1rem;
}
.icon-btn.liked { color: var(--primary); }

.notice {
  font-size: .8rem;
  line-height: 1.65;
  color: var(--muted);
  background: color-mix(in oklab, var(--secondary) 8%, var(--surface));
  border: 1px solid color-mix(in oklab, var(--secondary) 25%, var(--line));
  border-radius: 1rem;
  padding: .85rem 1rem;
}
.err {
  color: var(--danger);
  font-size: .85rem;
  line-height: 1.6;
}
.ok {
  color: var(--secondary);
  font-size: .85rem;
  line-height: 1.6;
}

.result-card {
  overflow: hidden;
  border-radius: 1.2rem;
  border: 1px solid var(--line);
  background: var(--surface);
}
.result-card img.cover {
  width: 100%;
  aspect-ratio: 16/9;
  object-fit: cover;
  background: var(--canvas);
  display: block;
}
.result-card .body { padding: 1rem; display: flex; flex-direction: column; gap: .65rem; }

.stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: .4rem;
  text-align: center;
}
.stat {
  background: var(--surface);
  border-radius: .9rem;
  padding: .7rem .25rem;
}
.stat b { display: block; font-size: .9rem; }
.stat span { font-size: .68rem; color: var(--muted); }

.inbox-item {
  border-radius: 1rem;
  border: 1px solid var(--line);
  background: var(--surface);
  padding: .85rem 1rem;
}
.inbox-item.unread {
  border-color: color-mix(in oklab, var(--primary) 45%, var(--line));
  background: var(--raised);
}
.inbox-item h3 { margin: 0; font-size: .92rem; }
.inbox-item p { margin: .35rem 0 0; font-size: .82rem; color: var(--muted); line-height: 1.6; white-space: pre-wrap; }

.player {
  position: fixed;
  inset: 0;
  z-index: 50;
  background: var(--canvas);
  display: flex;
  justify-content: center;
}
.player-inner {
  width: 100%;
  max-width: 28rem;
  height: 100%;
  display: flex;
  flex-direction: column;
  background: var(--canvas);
}
.player-top {
  display: flex;
  align-items: center;
  gap: .5rem;
  padding: .55rem .65rem;
  background: var(--surface);
}
.player-top .title {
  flex: 1;
  min-width: 0;
  font-size: .9rem;
  font-weight: 700;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.player-stage {
  flex: 1;
  min-height: 0;
  background: var(--canvas);
  position: relative;
}
.player-stage iframe,
.player-stage video {
  width: 100%;
  height: 100%;
  border: 0;
  background: var(--canvas);
  object-fit: contain;
}
.player-foot {
  background: var(--surface);
  padding: .9rem 1rem 1.2rem;
  display: flex;
  flex-direction: column;
  gap: .55rem;
}

/* ── native seek controls ── */
.native-stage {
  position: relative;
  overflow: hidden;
}
.seek-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: row;
  direction: ltr; /* left zone = screen left, right zone = screen right */
  z-index: 2;
  pointer-events: none;
}
.seek-zone {
  flex: 1;
  pointer-events: auto;
  -webkit-tap-highlight-color: transparent;
}
.seek-flash {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scale(.85);
  z-index: 4;
  background: rgba(0, 0, 0, .72);
  color: #fff;
  font-weight: 700;
  font-size: 1.05rem;
  padding: .55rem 1rem;
  border-radius: 999px;
  opacity: 0;
  pointer-events: none;
  transition: opacity .2s ease, transform .2s ease;
  letter-spacing: .02em;
}
.seek-flash.show {
  opacity: 1;
  transform: translate(-50%, -50%) scale(1);
}
.custom-controls {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 3;
  padding: .55rem .75rem .7rem;
  background: linear-gradient(transparent, rgba(0, 0, 0, .75));
  pointer-events: none;
}
.custom-controls .time-row {
  display: flex;
  align-items: center;
  gap: .55rem;
  pointer-events: auto;
  direction: ltr; /* time + scrub left→right */
}
.custom-controls .cur-time,
.custom-controls .dur-time {
  font-size: .72rem;
  font-variant-numeric: tabular-nums;
  color: rgba(255, 255, 255, .9);
  min-width: 2.4rem;
  text-align: center;
  flex-shrink: 0;
}
.scrubber {
  flex: 1;
  min-width: 0;
  height: 1.4rem;
  display: flex;
  align-items: center;
  cursor: pointer;
  touch-action: none;
  outline: none;
}
.scrub-track {
  position: relative;
  width: 100%;
  height: .28rem;
  border-radius: 999px;
  background: rgba(255, 255, 255, .28);
}
.scrub-fill {
  position: absolute;
  inset: 0 auto 0 0;
  width: 0;
  border-radius: inherit;
  background: var(--primary, #e8c4a0);
  pointer-events: none;
}
.scrub-thumb {
  position: absolute;
  top: 50%;
  left: 0;
  width: .85rem;
  height: .85rem;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 1px 6px rgba(0, 0, 0, .45);
  transform: translate(-50%, -50%);
  pointer-events: none;
  transition: transform .12s ease;
}
.scrubber.dragging .scrub-thumb,
.scrubber:focus-visible .scrub-thumb {
  transform: translate(-50%, -50%) scale(1.25);
}
.scrubber.dragging .scrub-track {
  height: .38rem;
}
.seek-hint {
  font-size: .72rem;
  line-height: 1.4;
}

.toast {
  position: fixed;
  left: 50%;
  bottom: calc(4.8rem + var(--safe-bottom));
  transform: translateX(-50%);
  z-index: 60;
  max-width: min(22rem, calc(100% - 2rem));
  background: var(--raised);
  border: 1px solid var(--line);
  color: var(--fg);
  border-radius: 999px;
  padding: .7rem 1.1rem;
  font-size: .82rem;
  box-shadow: 0 10px 30px rgba(0,0,0,.35);
}

.progress {
  height: .35rem;
  border-radius: 999px;
  background: var(--line);
  overflow: hidden;
}
.progress > i {
  display: block;
  height: 100%;
  width: 0;
  background: var(--primary);
  border-radius: inherit;
}

.seg {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: .4rem;
}
.seg button {
  min-height: 2.5rem;
  border-radius: .85rem;
  background: var(--raised);
  color: var(--fg);
  font-size: .8rem;
  font-weight: 600;
}
.seg button.on {
  background: var(--primary);
  color: var(--bg);
}

@media (min-width: 480px) {
  .app { box-shadow: 0 0 0 1px var(--line); }
}
